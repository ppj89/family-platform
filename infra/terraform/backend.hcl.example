# Copy to backend.hcl (git-ignored) and fill in the R2 values from
# .env.production on the server (APP_MEDIA_S3_*).
bucket     = "<APP_MEDIA_S3_BUCKET>"
key        = "terraform/github.tfstate"
region     = "auto"
endpoints  = { s3 = "<APP_MEDIA_S3_ENDPOINT>" }
access_key = "<APP_MEDIA_S3_ACCESS_KEY_ID>"
secret_key = "<APP_MEDIA_S3_SECRET_ACCESS_KEY>"

skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
use_lockfile                = true
