POSTGRES_DB=family_platform
POSTGRES_USER=family_app
POSTGRES_PASSWORD=change-this-long-random-db-password

APP_CORS_ALLOWED_ORIGINS=https://family.example.com,https://localhost,http://localhost,capacitor://localhost
APP_SECURITY_TOKEN_SECRET=change-this-at-least-64-random-characters-before-production
APP_SECURITY_TOKEN_VALIDITY_SECONDS=86400
APP_SECURITY_AUTO_LOGIN_VALIDITY_SECONDS=2592000
APP_PUBLIC_BASE_URL=https://family.example.com
APP_OAUTH_GOOGLE_CLIENT_ID=
APP_OAUTH_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_PLACES_API_KEY=
APP_OAUTH_NAVER_CLIENT_ID=
APP_OAUTH_NAVER_CLIENT_SECRET=
APP_OAUTH_KAKAO_CLIENT_ID=
APP_OAUTH_KAKAO_CLIENT_SECRET=
APP_KAKAO_REST_API_KEY=
APP_AUTH_EMAIL_VERIFICATION_REQUIRED=true
APP_WITHDRAWN_ACCOUNT_RETENTION_DAYS=365
APP_ACTIVITY_HISTORY_RETENTION_DAYS=365
APP_ACTIVITY_AGGREGATE_RETENTION_DAYS=365
APP_HOLIDAY_SYNC_ENABLED=true
APP_HOLIDAY_SYNC_SERVICE_KEY=
APP_HOLIDAY_API_BASE_URL=http://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService/getRestDeInfo
APP_HOLIDAY_SYNC_YEAR_WINDOW_BEFORE=1
APP_HOLIDAY_SYNC_YEAR_WINDOW_AFTER=2
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_FROM=
APP_MEDIA_MAX_FILE_SIZE=30MB
APP_MEDIA_MAX_REQUEST_SIZE=40MB
APP_MEDIA_MAX_FILES_PER_POST=5
APP_MEDIA_MAX_REFERENCE_LENGTH=2048
# 기본 미디어 정책: 기록 1건당 최대 5개, 계정당 총 1GB, 사진 5MB, 영상 20MB.
# 관리자는 관리자 > 제재 화면에서 개별 계정의 총 용량 제한만 해제할 수 있습니다.
APP_MEDIA_SIZE_LIMITS_ENABLED=true
APP_MEDIA_MAX_IMAGE_SIZE=5MB
APP_MEDIA_MAX_VIDEO_SIZE=20MB
APP_MEDIA_USER_QUOTA=1GB
# 메뉴별 첨부 개수 제한은 현재 미적용 상태입니다. 적용이 필요할 때 아래 두 줄의 주석을 해제합니다.
# APP_MEDIA_MENU_LIMITS_ENABLED=true
# APP_MEDIA_MENU_MAX_FILES=restaurant=6,baby=6,diary=6,community=4
APP_MEDIA_STORAGE_DRIVER=local
APP_MEDIA_STORAGE_PATH=/app/uploads
APP_MEDIA_PUBLIC_URL_PREFIX=/api/media/files
APP_MEDIA_S3_ENDPOINT=
APP_MEDIA_S3_REGION=auto
APP_MEDIA_S3_BUCKET=
APP_MEDIA_S3_ACCESS_KEY_ID=
APP_MEDIA_S3_SECRET_ACCESS_KEY=
# PostgreSQL backup: R2 bucket under database-backups/. One backup is made every 24 hours and files older than 7 days are deleted.
APP_DB_BACKUP_PREFIX=database-backups/
APP_DB_BACKUP_KEEP_DAYS=7
APP_DB_BACKUP_INTERVAL_SECONDS=86400
VITE_ADS_ENABLED=false
VITE_ADS_PROVIDER=admob
VITE_ADMOB_BANNER_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_UNIT_ID=
APP_ADMOB_APP_ID=

VITE_API_BASE_URL=/api
WEB_PORT=80
APP_DOMAIN=family.example.com
